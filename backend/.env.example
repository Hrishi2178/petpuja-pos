# Leave blank to use local SQLite (petpuja_pos.db)
# For Supabase or Neon PostgreSQL, paste your pooled connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Comma-separated frontend URLs allowed by CORS (use * for development)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
